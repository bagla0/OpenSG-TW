\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces $\sigma _{13}$ on the $x=0$ edge face (side view, thickness vertical): the core shear plateau --- the sandwich's design-driving field. Maxima 234.7 (RM) vs.\ 232.8 MPa (solid): \textbf  {0.8\,\%}.}}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces $\sigma _{23}$ on the $y=0$ edge face: the twin plateau, 230.0 vs.\ 228.0 MPa: \textbf  {0.9\,\%}.}}{9}{}\protected@file@percent }
